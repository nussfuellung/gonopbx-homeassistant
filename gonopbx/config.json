{
  "name": "GonoPBX",
  "version": "1.0.0",
  "slug": "gonopbx",
  "description": "Modern Asterisk PBX with Web Interface",
  "startup": "services",
  "boot": "auto",
  "arch": ["amd64"],
  "init": false,

  "host_network": true,

  "ingress": true,
  "ingress_port": 8080,
  "panel_icon": "mdi:phone",

  "options": {
    "web_port": 8080
  },

  "schema": {
    "web_port": "port"
  },

  "map": [
    "config:rw",
    "ssl"
  ]
}
