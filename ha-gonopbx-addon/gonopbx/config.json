{
  "name": "GonoPBX",
  "version": "1.0.0",
  "slug": "gonopbx",
  "description": "Modern Asterisk PBX with Web UI",
  "startup": "services",
  "boot": "auto",
  "host_network": true,
  "arch": ["armhf", "armv7", "aarch64", "amd64"],
  "ports": {
    "8080/tcp": 8080,
    "5060/udp": 5060
  },
  "map": [
    "config:rw",
    "ssl"
  ]
}
